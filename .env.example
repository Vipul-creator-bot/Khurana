PORT=4000
CORS_ORIGIN=https://khuranakitchenware.com

# Get these from https://dashboard.razorpay.com/app/keys (use Test Mode keys while developing)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Used to sign login/registration session tokens. Set this to a long, random,
# unique string in production (e.g. `openssl rand -hex 32`) — never use the
# placeholder below outside local development.
JWT_SECRET=dev-only-insecure-secret-change-me

# Your store's exact coordinates and delivery radius. Get lat/lng by
# right-clicking your store's location on Google Maps — the first number
# shown is latitude, the second is longitude. The service area is Gurgaon
# city, so the radius is set wide enough to cover it — orders also require
# an address that mentions Gurgaon/Gurugram (see backend/utils/geo.js).
STORE_LAT=28.5017
STORE_LNG=77.0870
DELIVERY_RADIUS_KM=30

# Comma-separated list of email addresses that get admin access automatically
# on registration (e.g. to access the /admin broadcast and stock pages).
ADMIN_EMAILS=khuranakitchenware@gmail.com

# WhatsApp broadcast (via Twilio's WhatsApp API — https://www.twilio.com/whatsapp)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- Tally integration ----
# Only needed if this backend runs ON THE SAME MACHINE/NETWORK as Tally
# (direct sync). If Tally is at your shop and this backend is hosted
# remotely (e.g. Hostinger), leave these as defaults — direct sync will
# just fail gracefully and every change queues for tally-sync-agent.js
# instead, which you run at the shop. See README "Tally integration".
TALLY_HOST=localhost
TALLY_PORT=9000
TALLY_COMPANY=

# Shared secret that authenticates tally-sync-agent.js (running at your
# shop) against this backend's Tally queue endpoints, without needing a
# full admin login. Set the SAME value here and in the agent's environment.
# Generate one with: openssl rand -hex 24
TALLY_SYNC_API_KEY=
